# Required in every environment. Use a long random value for SECRET_KEY.
SECRET_KEY=

# PostgreSQL connection string.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Business timezone for date-based rules such as upload month locking.
APP_TIMEZONE=Europe/Moscow

# Email / SMTP settings.
# Set EMAIL_ENABLED=true only after configuring all SMTP_* variables below.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# true for SSL (port 465); false for STARTTLS (port 587)
SMTP_USE_SSL=true
# Display name shown in From header (optional, defaults to SMTP_USER)
SMTP_FROM_NAME=

# S3-совместимое хранилище (Timeweb Object Storage) — для загруженных документов,
# QR и генерируемых файлов. Значения берутся из карточки бакета в панели Timeweb.
# Если S3_BUCKET / S3_ACCESS_KEY / S3_SECRET_KEY не заданы — приложение работает
# в локальном режиме (файлы на диске), это режим разработки и тестов.
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Корни локального режима (в S3-режиме не используются).
DOCUMENT_UPLOAD_ROOT=uploaded_documents
GENERATED_FILES_ROOT=generated_files
